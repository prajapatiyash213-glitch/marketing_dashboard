# demo  = browser-only gate, verifies nothing. Local demos only.
# api   = posts credentials to your backend, which sets an httpOnly session cookie.
VITE_AUTH_MODE=demo

# Required when VITE_AUTH_MODE=api
VITE_AUTH_API_URL=https://api.yourcompany.com

# Currency used for all monetary figures (ISO 4217) and the locale used to format numbers.
VITE_CURRENCY=INR
VITE_LOCALE=en-IN

# Keep parsed workbooks in IndexedDB so a refresh does not clear the dashboard.
VITE_PERSIST=true
